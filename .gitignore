# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Django
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py
media/

# Secrets
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# WhiteNoise generates Brotli-compressed copies of static assets at
# collectstatic time. We commit the .gz copies but not .br — runtime
# Brotli compression on-demand is acceptable for this site's traffic.
staticfiles/**/*.br

# Database files, snapshots, and dumps never belong in this public repo:
# they can hold admin password hashes and session data. Content backups
# go in as JSON exports (dumpdata of website models only).
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.snapshot
*.db
*.dump
*.sql
